---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PublicationEntry from '../../components/PublicationEntry.astro';
import BoRefAttnNetDiagram from '../../components/diagrams/BoRefAttnNetDiagram.astro';
import DySTTMDiagram from '../../components/diagrams/DySTTMDiagram.astro';
import BoundaryCompare from '../../components/diagrams/BoundaryCompare.astro';
import ThesisPipelineDiagram from '../../components/diagrams/ThesisPipelineDiagram.astro';
import ThesisResults from '../../components/ThesisResults.astro';
import Button from '../../components/Button.astro';
import Draft from '../../components/Draft.astro';
import { profile, speaking, certifications, awards, education, fmtYM } from '../../lib/data';
import { notDraft } from '../../lib/drafts';
import { breadcrumbs } from '../../lib/schema';

const pubs = (await getCollection('publications', notDraft)).sort((a, b) => a.data.order - b.data.order);
const talks = speaking.filter((t) => ['ihpcss-2025', 'icict-2026'].includes(t.id));
const training = awards.filter((a) => a.kind === 'fellowship');
const msc = education.find((e) => e.id === 'msc-uleth')!;
const interests = [
  'Boundary-aware and shape-aware medical image segmentation',
  'Multimodal fusion of structural and functional neuroimaging',
  'Interpretable models for computational psychiatry',
  'Evaluation of large language models and agentic systems',
  'Reliable, human-in-the-loop AI for public safety and health',
];
---

<BaseLayout title="Research" description={`Publications, thesis and research interests of ${profile.name.scholarly}: boundary-refined 3D brain-MRI segmentation (BoRefAttnNet), multimodal spatial-temporal transformers for schizophrenia detection (DySTTM), and the evaluation of frontier AI systems.`} jsonLd={[breadcrumbs([{ name: 'Research', url: '/research/' }])]}>
  <PageHero overline="Research" tone="lagoon" title="Medical imaging, multimodal deep learning, and models that explain themselves." lede="My MSc at the University of Lethbridge (2023–2025, supervised by Dr. John Z. Zhang) asked how to segment small brain structures accurately at their boundaries, and how to read structure and function together to detect schizophrenia. Now I apply the same standards (rigorous evaluation, interpretability, humans in the loop) to systems in health, public safety and education." seed="research" size="large" />

  <section class="section" aria-labelledby="pubs-title">
    <div class="container">
      <SectionHeading overline="Publications" tone="lagoon" title="Papers and thesis" lede="Each entry links to the publisher's record. BibTeX is one click away." id="pubs-title" />
      <div class="pubs">
        {pubs.map((p) => <PublicationEntry entry={p} showAbstract />)}
      </div>
      <p class="mono faint pubs__profiles">
        Also on <a href={`https://scholar.google.com/citations?user=${profile.identifiers.scholar}`} rel="noopener">Google Scholar</a> · <a href={`https://orcid.org/${profile.identifiers.orcid}`} rel="noopener">ORCID {profile.identifiers.orcid}</a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="thesis-title">
    <div class="container">
      <SectionHeading overline="The thesis, visually" tone="lagoon" title="Two models, one idea: respect the boundary" lede="Conceptual diagrams of the two contributions, and the numbers the thesis measured." id="thesis-title" action={{ label: 'Thesis page', href: '/research/thesis/' }} />
      <div class="diagrams">
        <div class="diagram diagram--split">
          <div>
            <p class="overline">The problem</p>
            <h3>Small structures are measured at their edges</h3>
            <p class="diagram__lede">A plain voxel classifier is confident in the middle of the hippocampus and vague at its boundary, and the boundary is where group differences in schizophrenia are measured. Drag the handle to compare.</p>
          </div>
          <BoundaryCompare caption="Left of the handle: a voxel-wise prediction with a soft, uncertain edge. Right: the same structure with its boundary learned explicitly. Conceptual illustration, not patient data." />
        </div>
        <div class="diagram diagram--results">
          <ThesisResults variant="headline" />
        </div>
        <div class="diagram">
          <p class="overline">The whole thesis</p>
          <h3>From two scans to one decision</h3>
          <p class="diagram__lede">Structure and function enter separately and meet in DySTTM; BoRefAttnNet is what makes the structural half trustworthy at the edges.</p>
          <ThesisPipelineDiagram />
        </div>
        <div class="diagram">
          <p class="overline">BoRefAttnNet</p>
          <h3>Boundary-refined 3D U-Net</h3>
          <p class="diagram__lede">Multi-scale boundary attention in the decoder highlights anatomically critical edges and suppresses background noise.</p>
          <BoRefAttnNetDiagram />
        </div>
        <div class="diagram">
          <p class="overline">DySTTM</p>
          <h3>Dynamic spatial-temporal transformer</h3>
          <p class="diagram__lede">Spatial attention over segmented structure, temporal attention over resting-state connectivity, fused for classification.</p>
          <DySTTMDiagram />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="talks-title">
    <div class="container three-col">
      <div>
        <SectionHeading overline="Talks & posters" tone="lagoon" title="Presented" id="talks-title" />
        <ul class="list" data-reveal-group>
          {talks.map((t) => (
            <li data-reveal>
              <span class="mono faint">{fmtYM(t.date)}</span>
              <span><strong>{t.event}</strong>{t.city && <span class="muted"> · {t.city}</span>}<br /><span class="muted">{t.title}</span>{t.status === 'draft' && <Draft badgeOnly q="Q13" />}</span>
            </li>
          ))}
        </ul>
        <p class="more-link"><a href="/speaking/">All speaking →</a></p>
      </div>
      <div>
        <SectionHeading overline="Training & fellowships" tone="lagoon" title="Learned from" />
        <ul class="list" data-reveal-group>
          {training.map((a) => (
            <li data-reveal>
              <span class="mono faint">{fmtYM(a.date)}</span>
              <span><strong>{a.title}</strong><span class="muted"> · {a.issuer}</span>{a.status === 'draft' && <Draft badgeOnly q="Q17" />}{a.summary && <><br /><span class="muted">{a.summary}</span></>}</span>
            </li>
          ))}
          <li data-reveal>
            <span class="mono faint">{fmtYM(msc.start)}–{fmtYM(msc.end).slice(-4)}</span>
            <span><strong>Alberta Innovates Graduate Student Scholarship</strong><span class="muted"> · University of Lethbridge</span></span>
          </li>
        </ul>
      </div>
      <div>
        <SectionHeading overline="Certifications" tone="lagoon" title="Credentials" />
        <ul class="list" data-reveal-group>
          {certifications.filter((c) => c.featured || c.status === 'draft').map((c) => (
            <li data-reveal>
              <span class="mono faint">{fmtYM(c.issued)}</span>
              <span>
                <strong>{c.url ? <a href={c.url} rel="noopener">{c.title}</a> : c.title}</strong><span class="muted"> · {c.issuer}</span>
                {c.expires && <span class="muted"> · valid to {fmtYM(c.expires)}</span>}
                {c.status === 'draft' && <Draft badgeOnly q="Q16" />}
              </span>
            </li>
          ))}
        </ul>
        <details class="more">
          <summary class="mono">Earlier coursework ({certifications.filter((c) => !c.featured && c.status !== 'draft').length})</summary>
          <ul class="list list--tight">
            {certifications.filter((c) => !c.featured && c.status !== 'draft').map((c) => (
              <li><span class="mono faint">{fmtYM(c.issued)}</span><span>{c.title}<span class="muted"> · {c.issuer}</span></span></li>
            ))}
          </ul>
        </details>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="interests-title">
    <div class="container two-col">
      <div>
        <SectionHeading overline="Interests" tone="lagoon" title="Open to collaborate on" id="interests-title" />
        <ol class="interests" data-reveal-group>
          {interests.map((it) => <li data-reveal>{it}</li>)}
        </ol>
      </div>
      <div>
        <SectionHeading overline="Code & data" tone="lagoon" title="Reproducibility" />
        <p class="prose">The thesis experiments use the public <abbr title="Centre for Biomedical Research Excellence">COBRE</abbr> dataset, pre-processed with FastSurfer, and were trained on NVIDIA L4 GPUs (Google Cloud).</p>
        <div class="cluster code__cta">
          <Button href="/research/thesis/" variant="secondary" arrow>Read the thesis</Button>
          <Button href="/contact/" variant="text">Propose a collaboration →</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pubs {
    border-bottom: 1px solid var(--line);
  }
  .pubs__profiles {
    margin-top: var(--space-5);
    font-size: var(--step--2);
  }
  .diagrams {
    display: grid;
    gap: var(--space-8);
  }
  .diagram {
    min-width: 0;
  }
  .diagram h3 {
    margin-top: var(--space-2);
    font-size: var(--step-2);
  }
  .diagram--split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-7);
    align-items: center;
  }
  @media (max-width: 900px) {
    .diagram--split {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
  .diagram__lede {
    margin: var(--space-3) 0 var(--space-5);
    color: var(--ink-2);
    max-width: 60ch;
  }
  .three-col {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-7);
  }
  .two-col {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-9);
  }
  @media (max-width: 1000px) {
    .three-col {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 800px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--step--1);
  }
  .list--tight li {
    padding: 8px 0;
    font-size: var(--step--2);
  }
  .list .mono {
    font-size: var(--step--2);
    padding-top: 3px;
  }
  .more,
  .more-link {
    margin-top: var(--space-4);
  }
  .more-link a {
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
  }
  .more summary {
    cursor: pointer;
    font-size: var(--step--2);
    color: var(--amber);
  }
  .interests {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: i;
  }
  .interests li {
    counter-increment: i;
    position: relative;
    padding: var(--space-3) 0 var(--space-3) 48px;
    border-bottom: 1px solid var(--line);
  }
  .interests li::before {
    content: counter(i, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--lagoon);
  }
  .code__cta {
    margin-top: var(--space-6);
  }
</style>
