---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contours from '../components/Contours.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found" description="This page does not exist (any more)." noindex>
  <section class="nf">
    <div class="nf__art" aria-hidden="true">
      <Contours variant="rings" seed="404" lines={18} width={1200} height={1200} wobble={0.34} rMin={40} class="nf__contours" animate />
    </div>
    <div class="container nf__inner">
      <p class="overline" data-reveal>404</p>
      <h1 class="display" data-reveal>Outside the boundary.</h1>
      <p class="nf__lede" data-reveal>There's nothing at this address. The old site had many pages that aren't mine; if you followed a link to one of them, this is why.</p>
      <div class="cluster" data-reveal>
        <Button href="/" arrow>Home</Button>
        <Button href="/work/" variant="secondary">Work</Button>
        <Button href="/research/" variant="secondary">Research</Button>
        <Button href="/journal/" variant="secondary">Journal</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    overflow: hidden;
    min-height: 70vh;
    display: flex;
    align-items: center;
  }
  .nf__art {
    position: absolute;
    right: -20%;
    top: -30%;
    width: min(900px, 110vw);
    aspect-ratio: 1;
    color: var(--amber-bright);
    opacity: 0.7;
  }
  .nf__contours {
    width: 100%;
    height: 100%;
  }
  .nf__inner {
    position: relative;
    padding: var(--space-9) var(--gutter);
  }
  .nf__lede {
    margin: var(--space-5) 0 var(--space-6);
    font-size: var(--step-3);
    color: var(--ink-2);
    max-width: 44ch;
    text-wrap: pretty;
  }
</style>
