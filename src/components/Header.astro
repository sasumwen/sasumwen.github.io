---
import { profile } from '../lib/data';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;

const nav = [
  { label: 'About', href: '/about/' },
  { label: 'Work', href: '/work/' },
  { label: 'Research', href: '/research/' },
  { label: 'Writing', href: '/writing/' },
  { label: 'Journal', href: '/journal/' },
  { label: 'Contact', href: '/contact/' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${profile.name.preferred}, home`}>
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.4">
          <path d="M16 3.5c7 0 12.5 5.5 12.5 12.5S23 28.5 16 28.5 3.5 23 3.5 16 9 3.5 16 3.5Z" opacity=".35" />
          <path d="M16 7.5c4.8 0 8.5 3.7 8.5 8.5S20.8 24.5 16 24.5 7.5 20.8 7.5 16 11.2 7.5 16 7.5Z" opacity=".6" />
          <path d="M16 11.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9Z" />
        </svg>
      </span>
      <span class="brand__name">{profile.name.preferred}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--small btn--secondary resume-link" href="/resume/">Resume</a>
      <ThemeToggle />
      <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu">
        <span class="nav-toggle__bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-nav-panel hidden>
    <nav aria-label="Primary (mobile)" class="container">
      <ul>
        {
          nav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <span class="mono faint">0{i + 1}</span>
                {item.label}
              </a>
            </li>
          ))
        }
        <li style={`--i:${nav.length}`}>
          <a href="/resume/"><span class="mono faint">0{nav.length + 1}</span>Resume</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-2) var(--ease), background-color var(--dur-2) var(--ease);
  }
  .site-header.is-compact {
    border-bottom-color: var(--line);
  }
  .site-header--overlay:not(.is-compact) {
    position: absolute;
    left: 0;
    right: 0;
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    --ink: #efe9df;
    --ink-2: #d9d3c8;
    --paper: #15130f;
    --line: rgba(239, 233, 223, 0.25);
    --amber: #f0b759;
  }
  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-5);
    height: 72px;
    transition: height var(--dur-2) var(--ease);
  }
  .is-compact .site-header__inner {
    height: 60px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    justify-self: start;
  }
  .brand__mark {
    color: var(--amber);
    display: inline-flex;
    transition: transform var(--dur-3) var(--ease);
  }
  .brand:hover .brand__mark {
    transform: rotate(90deg);
  }
  .brand__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    font-variation-settings: 'opsz' 24, 'SOFT' 40;
  }
  .site-nav ul {
    display: flex;
    gap: clamp(14px, 2vw, 30px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    position: relative;
    display: inline-block;
    padding: 6px 0;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }
  .site-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--amber-bright);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-2) var(--ease);
  }
  .site-nav a:hover::after,
  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .site-nav a[aria-current='page'] {
    color: var(--ink);
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    justify-content: end;
    gap: var(--space-2);
  }
  .resume-link {
    display: inline-flex;
  }
  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: var(--radius-2);
    color: var(--ink);
  }
  .nav-toggle__bars {
    display: block;
    width: 18px;
    height: 12px;
    position: relative;
  }
  .nav-toggle__bars i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur-2) var(--ease), top var(--dur-2) var(--ease);
  }
  .nav-toggle__bars i:first-child {
    top: 1px;
  }
  .nav-toggle__bars i:last-child {
    top: 9px;
  }
  .nav-toggle[aria-expanded='true'] i:first-child {
    top: 5px;
    transform: rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] i:last-child {
    top: 5px;
    transform: rotate(-45deg);
  }
  .mobile-nav {
    display: none;
    border-top: 1px solid var(--line);
    background: var(--paper);
    padding: var(--space-4) 0 var(--space-6);
  }
  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-nav li {
    opacity: 0;
    transform: translateY(6px);
    animation: navIn var(--dur-3) var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 40ms);
  }
  @keyframes navIn {
    to {
      opacity: 1;
      transform: none;
    }
  }
  .mobile-nav a {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .mobile-nav a[aria-current='page'] {
    color: var(--amber);
  }

  @media (max-width: 899px) {
    .site-nav,
    .resume-link {
      display: none;
    }
    .site-header__inner {
      grid-template-columns: 1fr auto;
    }
    .nav-toggle {
      display: inline-flex;
    }
    .mobile-nav:not([hidden]) {
      display: block;
    }
    .site-header--overlay:not(.is-compact) .mobile-nav {
      --ink: #17161a;
      --paper: #f7f3ec;
      --line: rgba(23, 22, 26, 0.14);
      --amber: #9a5a12;
    }
    :global(:root[data-theme='dark']) .site-header--overlay:not(.is-compact) .mobile-nav {
      --ink: #efe9df;
      --paper: #15130f;
      --line: rgba(239, 233, 223, 0.14);
      --amber: #e6a646;
    }
  }
</style>
