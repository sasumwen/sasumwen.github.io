---
interface Props {
  items: { name: string; href: string }[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

<nav class:list={['crumbs', className]} aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {
      items.map((it, i) => (
        <li aria-current={i === items.length - 1 ? 'page' : undefined}>
          {i === items.length - 1 ? <span>{it.name}</span> : <a href={it.href}>{it.name}</a>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs {
    margin-bottom: var(--space-5);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-3);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 6px;
    opacity: 0.6;
  }
  .crumbs a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--amber);
    text-decoration: underline;
  }
  .crumbs [aria-current='page'] span {
    color: var(--ink-2);
  }
</style>
