---
/**
 * Photo gallery with a keyboard-accessible lightbox (see src/scripts/site.ts).
 * Items without `src` render as consent/asset placeholders in preview builds.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SHOW_DRAFTS } from '../lib/drafts';

interface Item {
  src?: ImageMetadata;
  alt: string;
  caption?: string;
  placeholder?: string;
  span?: '1' | '2' | 'tall';
}
interface Props {
  items: Item[];
  /** When false, the whole gallery is withheld in production (people pictured have not consented). */
  consent?: boolean;
  columns?: 2 | 3 | 4;
  class?: string;
}
const { items, consent = true, columns = 3, class: className } = Astro.props;

const visible = consent || SHOW_DRAFTS;
const full = await Promise.all(items.map((it) => (it.src ? getImage({ src: it.src, width: 2000, format: 'jpg', quality: 86 }) : null)));
---

{
  visible && (
    <div class:list={['gallery', `gallery--${columns}`, className]} data-gallery data-reveal-group>
      {!consent && SHOW_DRAFTS && (
        <p class="gallery__notice mono">
          <span class="draft-badge">consent pending</span> This gallery is withheld from production until everyone pictured has agreed.
        </p>
      )}
      {items.map((it, i) => (
        <figure class:list={['gallery__item', `gallery__item--${it.span ?? '1'}`]} data-reveal>
          {it.src && full[i] ? (
            <a href={full[i]!.src} data-lb data-alt={it.alt} data-caption={it.caption ?? ''} aria-label={`Open image: ${it.alt}`}>
              <Image src={it.src} alt={it.alt} widths={[400, 800, 1200]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 400px" />
            </a>
          ) : SHOW_DRAFTS ? (
            <div class="gallery__placeholder mono">
              <span>{it.placeholder ?? it.alt}</span>
            </div>
          ) : null}
          {it.caption && it.src && <figcaption class="mono">{it.caption}</figcaption>}
        </figure>
      ))}
    </div>
  )
}

<style>
  .gallery {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    grid-auto-flow: dense;
    margin: var(--space-7) 0;
  }
  .gallery--2 { --cols: 2; }
  .gallery--3 { --cols: 3; }
  .gallery--4 { --cols: 4; }
  .gallery__notice {
    grid-column: 1 / -1;
    font-size: var(--step--2);
    color: var(--ink-2);
  }
  .gallery__item {
    margin: 0;
    position: relative;
  }
  .gallery__item--2 {
    grid-column: span 2;
  }
  .gallery__item--tall {
    grid-row: span 2;
  }
  .gallery__item a {
    display: block;
    border-radius: var(--radius-2);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--paper-3);
  }
  .gallery__item--tall a {
    aspect-ratio: 3 / 4;
    height: 100%;
  }
  .gallery__item--2 a {
    aspect-ratio: 16 / 9;
  }
  .gallery__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out), filter var(--dur-3) var(--ease);
  }
  .gallery__item a:hover :global(img) {
    transform: scale(1.03);
  }
  .gallery__placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: var(--space-4);
    text-align: center;
    color: var(--ink-2);
    font-size: 12px;
    overflow-wrap: anywhere;
    background:
      linear-gradient(135deg, transparent 48%, var(--line) 48%, var(--line) 52%, transparent 52%) 0 0 / 24px 24px,
      var(--paper-3);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-2);
  }
  .gallery__item--2 .gallery__placeholder {
    aspect-ratio: 16 / 9;
  }
  .gallery__item--tall .gallery__placeholder {
    aspect-ratio: auto;
    height: 100%;
    min-height: 240px;
  }
  figcaption {
    margin-top: var(--space-2);
    font-size: 12px;
    color: var(--ink-2);
  }
  @media (max-width: 700px) {
    .gallery {
      --cols: 2 !important;
    }
    .gallery__item--2 {
      grid-column: span 2;
    }
  }

  /* lightbox (global, injected by script) */
  :global(.lightbox) {
    border: 0;
    padding: 0;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    background: transparent;
    color: #efe9df;
  }
  :global(.lightbox::backdrop) {
    background: rgba(21, 19, 15, 0.94);
  }
  :global(.lightbox[open]) {
    display: grid;
    grid-template-columns: 64px 1fr 64px;
    grid-template-rows: 1fr auto;
    align-items: center;
    animation: lbIn 220ms var(--ease-out);
  }
  @keyframes lbIn {
    from { opacity: 0; transform: scale(0.98); }
  }
  :global(.lightbox__figure) {
    grid-column: 2;
    margin: 0;
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    max-height: 100vh;
    padding: var(--space-6) 0;
  }
  :global(.lightbox__figure img) {
    max-width: 100%;
    max-height: calc(100vh - 140px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-2);
  }
  :global(.lightbox__figure figcaption) {
    font-family: var(--font-mono);
    font-size: 13px;
    color: #d9d3c8;
    text-align: center;
  }
  :global(.lightbox__close),
  :global(.lightbox__nav) {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    color: #efe9df;
    font-size: 32px;
    line-height: 1;
    border-radius: 50%;
    border: 1px solid rgba(239, 233, 223, 0.25);
    justify-self: center;
    transition: background-color var(--dur-1) var(--ease);
  }
  :global(.lightbox__close:hover),
  :global(.lightbox__nav:hover) {
    background: rgba(239, 233, 223, 0.12);
  }
  :global(.lightbox__close) {
    position: fixed;
    top: 16px;
    right: 16px;
  }
  :global(.lightbox__nav--prev) {
    grid-column: 1;
  }
  :global(.lightbox__nav--next) {
    grid-column: 3;
  }
  :global(.lightbox__count) {
    grid-column: 2;
    text-align: center;
    padding-bottom: var(--space-4);
    font-size: 12px;
    color: #b3aca1;
  }
  @media (max-width: 600px) {
    :global(.lightbox[open]) {
      grid-template-columns: 44px 1fr 44px;
    }
  }
</style>
