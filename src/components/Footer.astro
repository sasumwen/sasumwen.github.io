---
import { profile } from '../lib/data';
import Contours from './Contours.astro';
import Draft from './Draft.astro';

const year = new Date().getFullYear();
const email = profile.contact.email;
---

<footer class="site-footer">
  <div class="site-footer__art" aria-hidden="true">
    <Contours variant="ridges" seed="footer" lines={7} width={1600} height={220} class="site-footer__contours" />
  </div>
  <div class="container site-footer__inner">
    <div class="site-footer__cta">
      <p class="overline">Say hello</p>
      <p class="site-footer__line">
        Working on medical-imaging AI, public-safety systems or education technology? <a href="/contact/">Let's talk.</a>
      </p>
      <p class="mono site-footer__email">
        <a href={`mailto:${email.address}`}>{email.address}</a>
        {email.status === 'draft' && <Draft q="Q19">public address to confirm</Draft>}
      </p>
    </div>

    <nav class="site-footer__col" aria-label="Site">
      <p class="overline overline--muted">Site</p>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/work/">Work</a></li>
        <li><a href="/research/">Research</a></li>
        <li><a href="/writing/">Writing</a></li>
        <li><a href="/journal/">Journal</a></li>
        <li><a href="/speaking/">Speaking</a></li>
        <li><a href="/updates/">Updates</a></li>
        <li><a href="/now/">Now</a></li>
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Elsewhere">
      <p class="overline overline--muted">Elsewhere</p>
      <ul>
        {profile.links.map((l) => <li><a href={l.href} rel="me noopener">{l.label}</a></li>)}
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
  </div>
  <div class="container site-footer__meta">
    <p class="mono faint">
      © {year} {profile.name.full} · {profile.location.display}
    </p>
    <p class="mono faint"><a href="/resume/">Resume</a></p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: var(--section);
    border-top: 1px solid var(--line);
    overflow: hidden;
    background: var(--paper);
  }
  .site-footer__art {
    color: var(--line-strong);
    position: absolute;
    inset: 0 0 auto 0;
    height: 220px;
    opacity: 0.9;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.8), transparent);
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.8), transparent);
  }
  .site-footer__contours {
    width: 100%;
    height: 100%;
  }
  .site-footer__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-7) var(--space-6);
    padding-top: var(--space-9);
    padding-bottom: var(--space-7);
  }
  .site-footer__line {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.2;
    max-width: 22ch;
    margin-top: var(--space-3);
    font-variation-settings: 'opsz' 48, 'SOFT' 40;
  }
  .site-footer__email {
    margin-top: var(--space-4);
  }
  .site-footer__col ul {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
  }
  .site-footer__col li + li {
    margin-top: 6px;
  }
  .site-footer__col a {
    color: var(--ink-2);
    text-decoration: none;
    font-size: var(--step--1);
  }
  .site-footer__col a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .site-footer__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    align-items: baseline;
    border-top: 1px solid var(--line);
    padding-top: var(--space-5);
    padding-bottom: var(--space-6);
    font-size: var(--step--2);
  }
  .site-footer__meta p {
    margin: 0;
  }
  .site-footer__meta a {
    color: inherit;
  }
  @media (max-width: 760px) {
    .site-footer__inner {
      grid-template-columns: 1fr 1fr;
    }
    .site-footer__cta {
      grid-column: 1 / -1;
    }
  }
</style>
