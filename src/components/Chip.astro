---
interface Props {
  href?: string;
  tone?: 'neutral' | 'lagoon' | 'amber';
  class?: string;
  size?: 'default' | 'small';
}
const { href, tone = 'neutral', class: className, size = 'default' } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['chip', `chip--${tone}`, `chip--${size}`, className]} href={href}>
  <slot />
</Tag>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1;
    padding: 9px 11px;
    border: 1px solid var(--line);
    border-radius: var(--radius-1);
    background: var(--paper-2);
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
    transition: border-color var(--dur-1) var(--ease), color var(--dur-1) var(--ease), background-color var(--dur-1) var(--ease);
  }
  a.chip:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .chip--lagoon {
    color: var(--lagoon);
    background: var(--lagoon-wash);
    border-color: transparent;
  }
  .chip--amber {
    color: var(--amber-deep);
    background: var(--amber-wash);
    border-color: transparent;
  }
  .chip--small {
    font-size: 11px;
    padding: 6px 8px;
  }
</style>
