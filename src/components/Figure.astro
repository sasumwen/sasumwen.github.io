---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SHOW_DRAFTS } from '../lib/drafts';

interface Props {
  src?: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  /** full-bleed inside prose */
  wide?: boolean;
  placeholder?: string;
  aspect?: string;
  class?: string;
}
const { src, alt, caption, credit, wide = false, placeholder, aspect, class: className } = Astro.props;
// A figure without an image is a plan, not content: it renders only in preview builds.
const render = !!src || SHOW_DRAFTS;
---

{render && (
<figure class:list={['figure', { 'figure--wide': wide }, className]} data-reveal>
  <div class="figure__media" style={aspect ? `aspect-ratio:${aspect}` : undefined}>
    {src ? <Image src={src} alt={alt} widths={[640, 960, 1400]} sizes={wide ? '(max-width: 1200px) 100vw, 1200px' : '(max-width: 760px) 100vw, 720px'} /> : <div class="figure__placeholder mono"><span><span class="draft-badge">material wanted</span> {placeholder ?? alt}</span></div>}
    <slot />
  </div>
  {(caption || credit) && (
    <figcaption>
      {caption && <span>{caption}</span>}
      {credit && <span class="figure__credit"> · {credit}</span>}
    </figcaption>
  )}
</figure>
)}

<style>
  .figure {
    margin: 0;
  }
  .figure--wide {
    width: min(1200px, calc(100vw - 2 * var(--gutter)));
    margin-left: 50%;
    transform: translateX(-50%);
  }
  .figure__media {
    border-radius: var(--radius-2);
    overflow: hidden;
    background: var(--paper-3);
  }
  .figure__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .figure__placeholder {
    display: grid;
    place-items: center;
    min-height: 240px;
    aspect-ratio: 3 / 2;
    padding: var(--space-5);
    text-align: center;
    color: var(--ink-2);
    font-size: var(--step--2);
    background:
      linear-gradient(135deg, transparent 48%, var(--line) 48%, var(--line) 52%, transparent 52%) 0 0 / 28px 28px,
      var(--paper-3);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-2);
  }
  figcaption {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-2);
  }
  .figure__credit {
    color: var(--ink-3);
  }
</style>
