---
interface Row {
  label: string;
  value: string;
  href?: string;
  draft?: boolean;
}
interface Props {
  rows: Row[];
  title?: string;
  class?: string;
  compact?: boolean;
}
const { rows, title, class: className, compact = false } = Astro.props;
import Draft from './Draft.astro';
---

<dl class:list={['facts', { 'facts--compact': compact }, className]}>
  {title && <p class="overline overline--muted facts__title">{title}</p>}
  {
    rows.map((r) => (
      <div class="facts__row">
        <dt class="mono">{r.label}</dt>
        <dd>
          {r.href ? <a href={r.href} rel={r.href.startsWith('http') ? 'noopener' : undefined}>{r.value}</a> : r.value}
          {r.draft && <Draft badgeOnly />}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .facts {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .facts__title {
    padding: var(--space-4) 0 var(--space-2);
  }
  .facts__row {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--step--1);
  }
  .facts--compact .facts__row {
    padding: 8px 0;
  }
  dt {
    font-size: var(--step--2);
    color: var(--ink-3);
    letter-spacing: 0.04em;
    padding-top: 2px;
  }
  dd {
    margin: 0;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  dd a {
    color: var(--ink);
    text-decoration-color: var(--line-strong);
  }
  dd a:hover {
    color: var(--amber);
  }
</style>
